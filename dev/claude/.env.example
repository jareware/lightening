# Copy to dev/claude/.env and fill in. Compose reads .env from this directory
# automatically. .env is gitignored and must stay that way -- it holds a token,
# and the address of a real Home Assistant instance.

# Long-lived Claude Code token. Generate it on a machine that is already signed
# in, with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# The Home Assistant instance to develop against.
#   HA_HOSTNAME + HA_HOST_IP  -> resolved inside the container via extra_hosts
#   HA_HOST_IP + HA_PORT      -> the targeted hole in the egress firewall
#   HA_TARGET                 -> read by frontend/vite.config.ts for the dev proxy
# The hostname in HA_TARGET must be HA_HOSTNAME, or it won't resolve.
HA_HOSTNAME=my-ha-host
HA_HOST_IP=192.0.2.10
HA_PORT=8123
HA_TARGET=http://my-ha-host:8123

# Outbound network policy for the dev container.
#   allowlist  only Anthropic's API, github/npm and Home Assistant (default)
#   any        no firewall at all -- including reachability of your host machine
# Changing this recreates the net container; re-run bin/claude afterwards.
EGRESS=allowlist

# Commit identity for work done inside the container. Commits made by the agent
# should also carry the Co-Authored-By trailer described in CLAUDE.md.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
