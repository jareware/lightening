#!/usr/bin/env bash
# Start an agentic dev session in the firewalled dev container.
#
# Usage:
#   bin/claude                 # a Claude Code session, in the checkout
#   bin/claude bash -l         # a shell instead
#   bin/claude npm run dev     # run one command
#
# Publishing is bin/push, which runs on the host -- the container holds no
# GitHub credential, so the agent can't push from in here.
#
# Note: `docker compose run claude` would spawn a container outside the
# firewalled network namespace. Never use it; this wrapper uses `exec`.
set -euo pipefail
cd "$(dirname "$0")/../dev/claude"

REPO_URL="https://github.com/jareware/lightening.git"
REPO_DIR="/home/dev/lightening"

if [ ! -f .env ]; then
  echo "dev/claude/.env is missing -- copy .env.example to .env and fill it in." >&2
  exit 1
fi

# --build is cheap when cached, and means a changed Dockerfile can't be missed.
docker compose up -d --build

# The dev container joins net's network namespace, so it inherits whatever rules
# are in it. Check rather than assume: an empty namespace is default-ACCEPT, and
# would leave the agent with a route to the LAN and the host.
#
# Polled, because `up -d` returns once the container is started -- which is
# before firewall.sh has finished applying anything.
firewalled=no
for _ in $(seq 1 40); do
  if docker compose exec -T net iptables -S OUTPUT 2>/dev/null | grep -q '^-P OUTPUT DROP'; then
    firewalled=yes
    break
  fi
  sleep 0.25
done

if [ "$firewalled" != yes ]; then
  echo >&2
  echo "REFUSING TO START: the egress firewall is not in effect." >&2
  echo "Check 'docker compose logs net' in dev/claude/, then recreate both:" >&2
  echo "  cd dev/claude && docker compose up -d --force-recreate" >&2
  exit 1
fi

# Recreating `net` gives it a new namespace, and compose does not recreate the
# containers joined to it -- they're left pointing at a dead one, with no
# network at all. Fails closed, but it needs fixing, and recreating the dev
# container costs nothing when its network is already gone.
if [ "$(docker compose exec -T claude readlink /proc/self/ns/net 2>/dev/null)" \
     != "$(docker compose exec -T net readlink /proc/self/ns/net 2>/dev/null)" ]; then
  echo "Dev container is on a stale network namespace; recreating it..."
  docker compose up -d --force-recreate claude
fi

# First run: the container starts empty, since nothing is bind-mounted.
if ! docker compose exec -T claude test -d "$REPO_DIR/.git"; then
  echo "First run -- cloning the repository into the container..."
  docker compose exec -T claude git clone --quiet "$REPO_URL" "$REPO_DIR"
  echo "Cloned to $REPO_DIR. Run 'npm ci' in frontend/ before using the dev server."
fi

if [ $# -eq 0 ]; then
  exec docker compose exec -it -w "$REPO_DIR" claude claude
else
  exec docker compose exec -it -w "$REPO_DIR" claude "$@"
fi
